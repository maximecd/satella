{
  "name": "@satella-app/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "exports": {
    "./api": {
      "types": "./src/api/Api.ts",
      "import": "./src/api/Api.ts",
      "default": "./src/api/Api.ts"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "node scripts/dev.mjs",
    "db:reset": "tsx src/database/cli.ts reset",
    "db:seed": "tsx src/database/cli.ts seed",
    "start": "node dist/main.mjs",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coingecko/coingecko-typescript": "7.1.0",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@journeyapps/sqlcipher": "6.0.0",
    "@satella-app/connector-core": "workspace:*",
    "@satella-app/connector-evm": "workspace:*",
    "@satella-app/connector-ibkr": "workspace:*",
    "@satella-app/connector-kraken": "workspace:*",
    "@satella-app/connector-okx": "workspace:*",
    "@satella-app/connector-trade-republic": "workspace:*",
    "decimal.js": "10.6.0",
    "effect": "catalog:",
    "hash-wasm": "^4.12.0",
    "viem": "^2.55.19",
    "playwright": "1.55.0",
    "yahoo-finance2": "4.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "tsx": "4.23.11",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
