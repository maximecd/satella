{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check && vp run -r typecheck",
    "dev": "node scripts/dev.mjs",
    "db:reset": "pnpm --filter @optimus/engine exec tsx src/database/cli.ts reset",
    "db:seed": "pnpm --filter @optimus/engine exec tsx src/database/cli.ts seed",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "prepare": "effect-tsgo patch --typescript --skip-missing",
    "release:package": "node scripts/package-release.mjs",
    "release:smoke": "node scripts/smoke-test-release.mjs",
    "start": "vp run -r build && concurrently --kill-others-on-fail \"vp run --filter @optimus/engine start\" \"wait-on http://127.0.0.1:3001/api/hello && vp run --filter @optimus/desktop start\"",
    "test": "vp run -r test",
    "test:coverage": "vp run -r test:coverage",
    "test:watch": "vp run -r --parallel test:watch",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "10.0.4",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": "26.7.0"
  },
  "packageManager": "pnpm@11.21.0"
}
