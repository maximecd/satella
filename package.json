{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "node scripts/check-migrations.mjs && vp check && vp run -r typecheck",
    "dev": "node scripts/dev.mjs",
    "db:reset": "pnpm --filter @satella-app/engine exec tsx src/database/cli.ts reset",
    "db:seed": "pnpm --filter @satella-app/engine exec tsx src/database/cli.ts seed",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "migration:seal": "node scripts/check-migrations.mjs --seal",
    "prepare": "effect-tsgo patch --typescript --skip-missing",
    "release:package": "node scripts/package-release.mjs",
    "release:smoke": "node scripts/smoke-test-release.mjs",
    "start": "vp run -r build && node scripts/start.mjs",
    "test": "vp run -r test && node --test scripts/*.test.mjs",
    "test:coverage": "vp run -r test:coverage",
    "test:watch": "vp run -r --parallel test:watch",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "catalog:",
    "concurrently": "10.0.4",
    "oxlint": "1.79.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": ">=26.1.0"
  },
  "packageManager": "pnpm@11.21.0"
}
